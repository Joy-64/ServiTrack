/* order list, unordered list, description list */
/*usan la etiqueta li para cada elemento de la lista*/
ol {
    list-style-type: decimal;
    margin-left: 20px;
}
ul {
    list-style-type: disc;
    margin-left: 20px;
}
dl {
    margin-left: 20px;
}
<div class="container">
    <h1>Lista ordenada</h1>
    <ol>
        <li>Elemento 1</li>
        <li>Elemento 2</li>
        <li>Elemento 3</li>
    </ol>

    <h1>Lista desordenada</h1>
    <ul>
        <li>Elemento A</li>
        <li>Elemento B</li>
        <li>Elemento C</li>
    </ul>

    <h1>Lista de descripción</h1>
    <dl>
        <dt>Término 1</dt>
        <dd>Descripción del término 1.</dd>
        <dt>Término 2</dt>
        <dd>Descripción del término 2.</dd>
    </dl>
</div>  