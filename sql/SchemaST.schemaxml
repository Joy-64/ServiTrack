<sql_create_table>CREATE TABLE `codigo_postal` (
  `id` bigint(11) NOT NULL AUTO_INCREMENT,
  `codpostal` varchar(10) NOT NULL,
  `localidad` varchar(50) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4</sql_create_table>
</table>
